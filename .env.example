# Salin berkas ini menjadi .env lalu isi nilainya.
# Prisma ORM v7 TIDAK memuat .env otomatis — prisma7.config.ts memuatnya via dotenv.

# Koneksi aplikasi (boleh memakai pooler Neon, berakhiran -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Koneksi langsung untuk migrasi Prisma (host TANPA -pooler).
# Bila kosong, prisma7.config.ts otomatis memakai DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Port HTTP server
PORT=3000

# Environment aplikasi
NODE_ENV=development

# Izinkan origin CORS (boleh "*" untuk pengembangan)
CORS_ORIGIN=*
